{
  "name": "traza",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Agent session exports drawn as a metro map: every step a station, every subagent a branch line, ride the line to replay.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --config vite.single.config.ts",
    "preview": "vite preview",
    "test": "node test/engine.mjs"
  },
  "dependencies": {
    "@fontsource/fira-code": "5.2.5",
    "@fontsource/fira-sans": "5.2.5",
    "@fontsource/fira-sans-condensed": "5.2.5",
    "@fontsource/fira-sans-extra-condensed": "5.2.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-haptics": "^0.0.6"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "^1.64.0",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vite-plugin-singlefile": "2.3.3"
  }
}
